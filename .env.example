# =============================================================================
# Burn Job Configuration Environment Variables
# =============================================================================

# -----------------------------------------------------------------------------
# Target Codebase & Profile Paths
# -----------------------------------------------------------------------------
# Path to the Java source code directory to be scanned and refactored
BURN_JOB_SRC_DIR=./test_project/src/main/java

# Path to KùzuDB database file
BURN_JOB_DB_PATH=./profiler_graph.db

# Path to profiler collapsed stack trace file (async-profiler / JFR)
BURN_JOB_PROFILE_PATH=./app_profiling_full.collapsed

# Path to agent run execution log
BURN_JOB_LOG_PATH=./runlog/agent_run.log

# -----------------------------------------------------------------------------
# Load Test Target Application Settings
# -----------------------------------------------------------------------------
# Target REST API host URL
BURN_JOB_HOST=http://localhost:8080

# Load test concurrency (number of concurrent clients)
BURN_JOB_CONCURRENCY=50

# Load test duration in seconds
BURN_JOB_DURATION_SEC=5

# -----------------------------------------------------------------------------
# LLM Agent & Refactoring Settings
# -----------------------------------------------------------------------------
# Maximum self-optimization loop iterations
BURN_JOB_MAX_ITERATIONS=3

# Execution backend: auto, llama.cpp, vllm, openai
BURN_JOB_BACKEND=auto

# Model identifier
BURN_JOB_MODEL=qwen3

# Path to local model GGUF file or HF model directory (for llama.cpp / vLLM)
BURN_JOB_MODEL_PATH=./Qwen3-4B/qwen3-4b-instruct.gguf

# Context window size for local model
BURN_JOB_N_CTX=8192

# Number of GPU layers to offload (-1 for all layers on Metal / CUDA)
BURN_JOB_N_GPU_LAYERS=-1

# -----------------------------------------------------------------------------
# Remote LLM API Keys & Custom Endpoints (Optional)
# -----------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
# LLM_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# VLLM_BASE_URL=http://localhost:8000/v1
