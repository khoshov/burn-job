#!/usr/bin/env python3
"""
`specify` CLI wrapper script for GitHub Spec Kit.
"""

import os
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
SPEC_KIT_PATH = os.path.join(SCRIPT_DIR, "spec_kit.py")

if __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, SPEC_KIT_PATH] + sys.argv[1:])
