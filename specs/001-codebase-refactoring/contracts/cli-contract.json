{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BurnJobCLIContract",
  "description": "JSON schema definition for burn-job command-line invocation arguments and subcommands",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "enum": ["scan", "ingest", "run-cycle", "report", "version"]
    },
    "subcommands": {
      "scan": {
        "description": "Scan target Java repository for endpoints and static performance anti-patterns",
        "properties": {
          "target": { "type": "string", "description": "Path to target repository" },
          "output": { "type": "string", "description": "Output path for scan report JSON" }
        },
        "required": ["target"]
      },
      "ingest": {
        "description": "Ingest JFR or async-profiler trace log into embedded KuzuDB graph",
        "properties": {
          "db": { "type": "string", "description": "Path to KuzuDB directory" },
          "profile": { "type": "string", "description": "Path to profile file (.jfr / .txt)" }
        },
        "required": ["db", "profile"]
      },
      "run-cycle": {
        "description": "Execute autonomous 8-step analysis & refinement cycle",
        "properties": {
          "target": { "type": "string", "description": "Path to target repository" },
          "db": { "type": "string", "description": "Path to KuzuDB directory" },
          "max-cycles": { "type": "integer", "default": 3, "minimum": 1 }
        },
        "required": ["target", "db"]
      }
    }
  },
  "required": ["command"]
}
